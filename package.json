{
  "name": "baocanmou-ai-skill-center",
  "private": true,
  "version": "1.3.0",
  "description": "BaoCanMou original local-first AI skill governance center.",
  "author": "BaoCanMou (包参谋) <https://www.bcmsj.com>",
  "license": "MIT",
  "homepage": "https://www.bcmsj.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yht0912/baocanmou-ai-skill-center.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:featured": "node --test scripts/fetch-featured-skills.node-test.mjs",
    "audit:skills": "python3 tools/skill_center_audit.py",
    "test:audit": "python3 -m unittest discover -s tools/tests -v",
    "rust:fmt": "cd src-tauri && cargo fmt --all",
    "rust:fmt:check": "cd src-tauri && cargo fmt --all -- --check",
    "rust:clippy": "cd src-tauri && cargo clippy --all-targets --all-features -- -D warnings",
    "rust:test": "cd src-tauri && cargo test",
    "check": "npm run lint && npm run test && npm run test:featured && npm run test:audit && npm run build && npm run rust:fmt:check && npm run rust:clippy && npm run rust:test",
    "preview": "vite preview",
    "version:set": "node scripts/version.mjs set",
    "version:sync": "node scripts/version.mjs sync",
    "version:check": "node scripts/version.mjs check",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "npm run version:check && tauri build --features custom-protocol",
    "tauri:build:mac:dmg": "npm run tauri:build -- --bundles dmg"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.1",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tauri-apps/cli": "^2.9.6",
    "@types/node": "^24.10.7",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.25",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.53.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.9"
  }
}
